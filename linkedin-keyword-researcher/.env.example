# ============================================================
# LinkedIn Keyword Researcher – Variables de entorno
# Copia este archivo a .env y completa tus valores
# ============================================================

# --- LinkedIn (REQUERIDO) ---
LINKEDIN_EMAIL=tu_email@gmail.com
LINKEDIN_PASSWORD=tu_password_linkedin

# --- Alertas por Email (OPCIONAL) ---
# Para Gmail: usa una "App Password" (no tu contraseña normal)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASS=tu_app_password_gmail
ALERT_EMAIL=destinatario@empresa.com

# --- Slack (OPCIONAL) ---
# Crea un incoming webhook en https://api.slack.com/apps
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
