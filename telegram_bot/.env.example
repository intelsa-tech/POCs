# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: comma-separated list of allowed Telegram user IDs (leave empty to allow all)
# Example: ALLOWED_USER_IDS=123456789,987654321
ALLOWED_USER_IDS=

# Optional: system prompt to give the bot a persona
SYSTEM_PROMPT=You are a helpful AI assistant powered by Claude. Be concise, clear, and friendly.

# Optional: max conversation history turns to keep (default: 20)
MAX_HISTORY_TURNS=20
